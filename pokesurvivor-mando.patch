diff --git a/js/core/gamepad.js b/js/core/gamepad.js
new file mode 100644
index 0000000..e38c429
--- /dev/null
+++ b/js/core/gamepad.js
@@ -0,0 +1,278 @@
+/* ============ gamepad.js — mando (Steam Deck, Xbox, PlayStation...) ============
+ * Usa la API Gamepad del navegador; no hace falta ninguna plantilla de Steam
+ * con "teclado y ratón". Se consulta una vez por fotograma desde game.js.
+ *
+ * En la partida:
+ *   stick izq. / cruceta  moverse           A B X Y   movimiento 1 2 3 4
+ *   LB / LT, RB / RT      ciclar (Q / E)    Start     pausa
+ * En menús y cartas (cualquier pantalla abierta):
+ *   cruceta / stick izq.  moverse entre botones (también ajusta barras)
+ *   A aceptar · B volver · Y cambiar opciones (nivel) · LB / RB cambiar de pestaña
+ *
+ * Todo lo que hace en la partida lo hace "inyectando" las mismas teclas que ya
+ * entiende el juego (G.Input.inject), así no hay que tocar la lógica de game.js.
+ */
+G.Pad = (() => {
+  const DEAD = 0.25;
+  const B = { A: 0, B: 1, X: 2, Y: 3, LB: 4, RB: 5, LT: 6, RT: 7, SELECT: 8, START: 9,
+              UP: 12, DOWN: 13, LEFT: 14, RIGHT: 15 };
+  const N = 17;
+
+  let prev = new Array(N).fill(false), cur = new Array(N).fill(false);
+  let ax = [0, 0];
+  let connected = false, preferred = false;
+  let focusEl = null, pendingTab = false;
+  const rep = { dir: null, t: 0, n: 0 };
+
+  const pressed = i => cur[i] && !prev[i];
+
+  // ---------------- lectura ----------------
+
+  function read() {
+    const list = navigator.getGamepads ? navigator.getGamepads() : [];
+    const now = new Array(N).fill(false);
+    let x = 0, y = 0, any = false;
+    for (const p of list) {
+      if (!p || !p.connected) continue;
+      any = true;
+      p.buttons.forEach((b, i) => { if (i < N && (b.pressed || b.value > 0.6)) now[i] = true; });
+      const px = p.axes[0] || 0, py = p.axes[1] || 0;
+      if (Math.hypot(px, py) > Math.hypot(x, y)) { x = px; y = py; }
+    }
+    connected = any;
+    prev = cur; cur = now;
+    const m = Math.hypot(x, y);
+    if (m < DEAD) { x = 0; y = 0; }
+    else { const k = Math.min(1, (m - DEAD) / (1 - DEAD)) / m; x *= k; y *= k; }
+    ax = [x, y];
+  }
+
+  /** Vector de movimiento (stick + cruceta), o null si no se toca nada. */
+  function axis() {
+    let x = ax[0], y = ax[1];
+    if (cur[B.LEFT]) x -= 1;
+    if (cur[B.RIGHT]) x += 1;
+    if (cur[B.UP]) y -= 1;
+    if (cur[B.DOWN]) y += 1;
+    if (!x && !y) return null;
+    const m = Math.hypot(x, y);
+    return m > 1 ? [x / m, y / m] : [x, y];
+  }
+
+  function setPreferred(v) {
+    if (preferred === v) return;
+    preferred = v;
+    document.body.classList.toggle('padmode', v);
+    if (!v) setFocus(null);
+  }
+
+  // ---------------- partida ----------------
+
+  function gameplay() {
+    const st = G.Game && G.Game.state;
+    if (G.Judgment && G.Judgment.cinematic) {
+      if (pressed(B.A) || pressed(B.B) || pressed(B.START)) G.Input.inject('enter');
+      return;
+    }
+    if (st !== 'playing' && st !== 'paused') return;
+    if (pressed(B.START)) G.Input.inject('escape');
+    if (st !== 'playing') return;
+    [B.A, B.B, B.X, B.Y].forEach((b, i) => { if (pressed(b)) G.Input.inject('digit' + (i + 1)); });
+    if (pressed(B.LB) || pressed(B.LT)) G.Input.inject('keyq');
+    if (pressed(B.RB) || pressed(B.RT)) G.Input.inject('keye');
+  }
+
+  // ---------------- menús ----------------
+
+  const CAND = 'button, a[href], input:not([type=hidden]), select, textarea, .card, .menu-item, .tab, .chip, ' +
+               '.cell:not(.locked), .answer, .gen-tab, [tabindex]:not([tabindex="-1"])';
+  const TEXT_INPUT = 'input:not([type]), input[type=text], input[type=password], input[type=email], input[type=search], textarea';
+
+  const $ = id => document.getElementById(id);
+  const shown = e => !e.closest('.hidden');
+
+  /** La capa más alta que está abierta (por z-index; si empatan, la última del documento). */
+  function topLayer() {
+    let best = null, bz = -1;
+    const all = [...document.querySelectorAll('.scr:not(.hidden), #pull-fx:not(.hidden), #tap-start:not(.hidden)')];
+    for (const el of all) {
+      const z = parseInt(getComputedStyle(el).zIndex, 10) || 0;
+      if (z >= bz) { best = el; bz = z; }
+    }
+    return best;
+  }
+
+  function candidates(top) {
+    let els = [...top.querySelectorAll(CAND)];
+    const tb = $('topbar');
+    if (top.id === 'scr-menu' && tb && !tb.classList.contains('hidden')) els = els.concat([...tb.querySelectorAll('button')]);
+    return els.filter(e => !e.disabled && shown(e) && e.getBoundingClientRect().width > 0 && e.getBoundingClientRect().height > 0);
+  }
+
+  function setFocus(el) {
+    if (focusEl) focusEl.classList.remove('padfocus');
+    focusEl = el;
+    if (!el) return;
+    el.classList.add('padfocus');
+    try { el.scrollIntoView({ block: 'nearest', inline: 'nearest' }); } catch (e) { /* nada */ }
+  }
+
+  function initial(top) {
+    const c = candidates(top);
+    return c.find(e => e.matches('.menu-item, .card')) || c.find(e => e.matches('.btn.gold')) || c[0] || null;
+  }
+
+  function center(e) { const r = e.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; }
+
+  /**
+   * Siguiente elemento en una dirección: primero la fila (o columna) más cercana
+   * y, dentro de ella, el que está más alineado. Así no se salta filas aunque
+   * otro botón más lejano quede justo debajo.
+   */
+  function spatial(top, dir) {
+    const c0 = center(focusEl);
+    const found = [];
+    for (const o of candidates(top)) {
+      if (o === focusEl || o.contains(focusEl) || focusEl.contains(o)) continue;
+      const c = center(o), dx = c.x - c0.x, dy = c.y - c0.y;
+      const [p, s] = dir === 'right' ? [dx, dy] : dir === 'left' ? [-dx, dy] : dir === 'down' ? [dy, dx] : [-dy, dx];
+      if (p > 4) found.push({ o, p, s: Math.abs(s) });
+    }
+    if (!found.length) return null;
+    const minP = Math.min(...found.map(f => f.p));
+    return found.filter(f => f.p <= minP + 28).sort((a, b) => a.s - b.s)[0].o;
+  }
+
+  function scrollSome(top, dy) {
+    const box = [top, ...top.querySelectorAll('*')].find(e => {
+      const o = getComputedStyle(e).overflowY;
+      return (o === 'auto' || o === 'scroll') && e.scrollHeight > e.clientHeight + 4;
+    });
+    if (box) box.scrollBy({ top: dy, behavior: 'auto' });
+  }
+
+  /** Dirección pulsada (cruceta o stick), con repetición al mantener. */
+  function direction() {
+    let d = null;
+    if (cur[B.UP] || ax[1] < -0.55) d = 'up';
+    else if (cur[B.DOWN] || ax[1] > 0.55) d = 'down';
+    else if (cur[B.LEFT] || ax[0] < -0.55) d = 'left';
+    else if (cur[B.RIGHT] || ax[0] > 0.55) d = 'right';
+    const now = performance.now();
+    if (!d) { rep.dir = null; return null; }
+    if (d !== rep.dir) { rep.dir = d; rep.t = now + 380; return d; }
+    if (now >= rep.t) { rep.t = now + 120; return d; }
+    return null;
+  }
+
+  function stepRange(el, sign) {
+    const step = Number(el.step) || 1, span = (Number(el.max) || 100) - (Number(el.min) || 0);
+    const v = Math.max(Number(el.min) || 0, Math.min(Number(el.max) || 100, Number(el.value) + sign * Math.max(step, span / 20)));
+    el.value = v;
+    el.dispatchEvent(new Event('input', { bubbles: true }));
+    el.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  function stepSelect(el, sign) {
+    const n = el.options.length;
+    if (!n) return;
+    el.selectedIndex = (el.selectedIndex + sign + n) % n;
+    el.dispatchEvent(new Event('input', { bubbles: true }));
+    el.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  function activate(el) {
+    if (el.matches(TEXT_INPUT)) { el.focus(); return; }
+    if (el.matches('input[type=range]')) return;
+    if (el.tagName === 'SELECT') { stepSelect(el, 1); return; }
+    el.click();
+  }
+
+  const BACK_TEXT = /^(volver|cerrar|atr[aá]s|cancelar|back|close|cancel)$/i;
+  function goBack(top) {
+    const btns = candidates(top).filter(e => e.matches('button, a'));
+    const b = btns.find(e => e.matches('[data-back]')) ||
+              btns.find(e => BACK_TEXT.test((e.textContent || '').trim()) || /(close|back)$/i.test(e.id || ''));
+    if (b) { b.click(); return; }
+    if (G.Game && G.Game.state === 'paused') G.Input.inject('escape');
+  }
+
+  function switchTab(top, sign) {
+    const tabs = candidates(top).filter(e => e.matches('.gen-tab'));
+    if (tabs.length < 2) return;
+    const i = tabs.findIndex(t => t.classList.contains('on'));
+    if (i < 0) return;
+    tabs[(i + sign + tabs.length) % tabs.length].click();
+    pendingTab = true;
+  }
+
+  function navigate(top, wasPad) {
+    // Con un campo de texto activo: A, B o Start lo sueltan; arriba/abajo lo sueltan y siguen
+    // navegando (el login lo deja activo al abrirse); izquierda/derecha mueven el cursor de escritura.
+    const ae = document.activeElement;
+    if (ae && ae.matches && ae.matches(TEXT_INPUT)) {
+      if (pressed(B.A) || pressed(B.B) || pressed(B.START)) { ae.blur(); return; }
+      if (pressed(B.UP) || pressed(B.DOWN) || ax[1] < -0.55 || ax[1] > 0.55) ae.blur();
+      else return;
+    }
+    // "Pulsa para empezar" y la animación del gacha: cualquier botón vale.
+    if (top.id === 'tap-start') { if (cur.some((v, i) => v && !prev[i])) top.click(); return; }
+    if (top.id === 'pull-fx') {
+      if (pressed(B.A) || pressed(B.B)) {
+        const c = $('pull-close');
+        (c && shown(c) ? c : $('slot')).click();
+      }
+      return;
+    }
+
+    if (pendingTab) {
+      pendingTab = false;
+      const t = top.querySelector('.gen-tab.on');
+      if (t) setFocus(t);
+    }
+    if (focusEl && (!focusEl.isConnected || !top.contains(focusEl) && !($('topbar') || document.body).contains(focusEl) || !shown(focusEl))) setFocus(null);
+
+    // Si ya se jugaba con el mando y la pantalla cambió (otra pantalla, otra pregunta), el cursor reaparece solo.
+    if (!focusEl && wasPad) setFocus(initial(top));
+
+    const dir = direction();
+    const act = pressed(B.A), back = pressed(B.B);
+    if (back) { goBack(top); return; }
+    if (pressed(B.START) && G.Game && G.Game.state === 'paused') { G.Input.inject('escape'); return; }
+    if (pressed(B.Y)) { const r = $('lvl-reroll'); if (r && shown(r) && top.contains(r)) { r.click(); return; } }
+    if (pressed(B.LB)) { switchTab(top, -1); return; }
+    if (pressed(B.RB)) { switchTab(top, 1); return; }
+    if (!dir && !act) return;
+
+    // Primera pulsación: sólo enseña dónde está el cursor.
+    if (!focusEl) { setFocus(initial(top)); return; }
+
+    if (act) { activate(focusEl); return; }
+
+    if ((dir === 'left' || dir === 'right') && focusEl.matches('input[type=range]')) { stepRange(focusEl, dir === 'right' ? 1 : -1); return; }
+    if ((dir === 'left' || dir === 'right') && focusEl.tagName === 'SELECT') { stepSelect(focusEl, dir === 'right' ? 1 : -1); return; }
+    const next = spatial(top, dir);
+    if (next) setFocus(next);
+    else if (dir === 'up' || dir === 'down') scrollSome(top, dir === 'down' ? 160 : -160);
+  }
+
+  // ---------------- bucle ----------------
+
+  /** Una vez por fotograma, justo antes de leer las teclas. */
+  function update() {
+    read();
+    const anyPress = cur.some((v, i) => v && !prev[i]);
+    const wasPad = preferred;
+    if (anyPress || ax[0] || ax[1]) setPreferred(true);
+    if (anyPress && G.Audio) G.Audio.unlock();
+    if (!connected) return;
+    const top = topLayer();
+    if (top) navigate(top, wasPad); else { if (focusEl) setFocus(null); gameplay(); }
+  }
+
+  // Ratón, táctil o teclado: vuelve a la vista normal (sin cursor del mando).
+  addEventListener('pointerdown', () => setPreferred(false), true);
+  addEventListener('keydown', () => setPreferred(false), true);
+
+  return { update, axis, setPreferred, get connected() { return connected; }, get preferred() { return preferred; } };
+})();
